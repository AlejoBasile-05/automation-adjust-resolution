{
  "name": "gustavo-automatizacion-images",
  "productName": "Ajuste de Resolucion",
  "version": "1.0.0",
  "description": "Automated image resolution adjustment: scan a source folder, resize images with Sharp, and write results to a destination folder.",
  "main": "desktop/main.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/server.js",
    "test": "jest",
    "build:frontend": "npm --prefix frontend run build",
    "desktop": "npm run build:frontend && electron .",
    "dist": "npm run build:frontend && electron-builder",
    "dist:linux": "npm run build:frontend && electron-builder --linux",
    "dist:win": "npm run build:frontend && electron-builder --win",
    "dist:mac": "npm run build:frontend && electron-builder --mac",
    "dist:dir": "npm run build:frontend && electron-builder --linux dir"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AlejoBasile-05/automation-adjust-resolution.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/AlejoBasile-05/automation-adjust-resolution/issues"
  },
  "homepage": "https://github.com/AlejoBasile-05/automation-adjust-resolution#readme",
  "dependencies": {
    "express": "^5.3.0",
    "sharp": "^0.35.5",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "electron": "^45.0.0",
    "electron-builder": "^26.15.3",
    "jest": "^30.5.2",
    "supertest": "^7.3.1"
  },
  "desktopName": "ajuste-de-resolucion.desktop"
}
